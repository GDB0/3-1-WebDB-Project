<table class="table table-bordered border-primary table-hover" style="text-align: center;">
  <thead class="table-primary">
    <th>ID</th><th>PW</th><th>이름</th><th>성별</th><th>주소</th><th>전화번호</th><th>생일</th><th>클래스</th><th colspan="2">메뉴</th>
  </thead>
  <% if(persons.length === 0) { %>
    <tr><td colspan="10">자료가 없으니 고객추가 버튼으로 고객을 추가해 주십시오</td></tr>
  <% } else { %>
    <% persons.forEach(function(p){ %>
      <tr>
        <td><%= p.loginid %></td>
        <td><%= p.password %></td>
        <td><%= p.name %></td>
        <td><%= p.mf === 'm' ? '남자' : (p.mf === 'f' ? '여자' : '') %></td>
        <td><%= p.address %></td>
        <td><%= p.tel %></td>
        <td><%= p.birth %></td>
        <td>
          <%= p.class %>
          <% if(p.class === 'CST') { %>(고객)<% } %>
          <% if(p.class === 'CEO') { %>(경영자)<% } %>
          <% if(p.class === 'MNG') { %>(관리자)<% } %>
        </td>
        <td><a href="/person/update/<%= p.loginid %>" style="text-decoration:none;">수정</a></td>
        <td><a href="/person/delete/<%= p.loginid %>" onclick='if(confirm("정말로 삭제하시겠습니까?")==false){return false}' style="text-decoration:none;">삭제</a></td>
      </tr>
    <% }) %>
  <% } %>
</table>
<a href="/person/create"><button class="btn btn-outline-secondary btn-sm" type="button">고객추가</button></a>
