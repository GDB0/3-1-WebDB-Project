<table class="table table-bordered" style="text-align: center;">
  <thead class="table-primary">
    <th>상품</th><th>상품명</th><th>가격</th><th>브랜드</th>
    <% if(!isHome) { %><th colspan="2"></th><% } %>
  </thead>
  <% if(products.length === 0) { %>
    <tr><td colspan="<%= isHome ? 4 : 6 %>">자료가 없으니 상품추가 버튼으로 상품을 추가해 주십시오</td></tr>
  <% } else { %>
    <% products.forEach(function(p){ %>
      <tr style="text-align:center; vertical-align:middle;">
        <td>
          <% if(p.image) { %>
            <a href="/detail/<%= p.prod_id %>" style="text-decoration:none;"><img src="/images/<%= p.image %>" style="width:100px;height:100px;"></a>
          <% } else { %>
            <a href="/detail/<%= p.prod_id %>" style="text-decoration:none;">이미지 없음</a>
          <% } %>
        </td>
        <td><%= p.name %></td><td><%= Number(p.price || 0).toLocaleString() %> 원</td><td><%= p.brand %></td>
        <% if(!isHome) { %>
          <td><a href="/product/update/<%= p.prod_id %>">수정</a></td>
          <td><a href="/product/delete/<%= p.prod_id %>" onclick="if(confirm('정말로 삭제하시겠습니까?')==false) return false">삭제</a></td>
        <% } %>
      </tr>
    <% }) %>
  <% } %>
</table>
<% if(!isHome) { %><a href="/product/create"><button class="btn btn-outline-secondary btn-sm" type="button">상품추가</button></a><% } %>
