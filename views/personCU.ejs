<div class="container">
  <h2><%= signup ? '회원가입' : ('관리자 기능 : ' + (mode === 'create' ? '회원생성' : '회원 정보 수정')) %></h2>
  <form action="<%= mode === 'create' ? '/person/create_process' : '/person/update_process' %>" method="post">
    <% if(signup) { %><input type="hidden" name="signup" value="Y"><% } %>
    <div class="mb-3"><label class="form-label">ID</label><input class="form-control" type="text" name="loginid" value="<%= person.loginid || '' %>" placeholder="아이디를 입력해 주세요" style="width:300px;"></div>
    <div class="mb-3"><label class="form-label">PW</label><input class="form-control" type="text" name="password" value="<%= person.password || '' %>" placeholder="패스워드를 입력해 주세요" style="width:300px;"></div>
    <div class="mb-3"><label class="form-label">이름</label><input class="form-control" type="text" name="name" value="<%= person.name || '' %>" placeholder="이름을 입력해 주세요" style="width:300px;"></div>
    <div class="mb-3"><label class="form-label">성별</label>&nbsp;&nbsp;&nbsp;<input type="radio" name="mf" value="m" <%= person.mf !== 'f' ? 'checked' : '' %>>&nbsp;남자&nbsp;&nbsp;&nbsp;<input type="radio" name="mf" value="f" <%= person.mf === 'f' ? 'checked' : '' %>>&nbsp;여자</div>
    <div class="mb-3"><label class="form-label">주소</label><input class="form-control" type="text" name="address" value="<%= person.address || '' %>" placeholder="주소를 입력해 주세요" style="width:300px;"></div>
    <div class="mb-3"><label class="form-label">전화번호</label><input class="form-control" type="text" name="tel" value="<%= person.tel || '' %>" placeholder="000-0000-0000" style="width:300px;"></div>
    <div class="mb-3"><label class="form-label">생일</label><input class="form-control" type="text" name="birth" value="<%= person.birth || '' %>" placeholder="YYYYMMDD" style="width:300px;"></div>
    <% if(!signup) { %>
    <div class="mb-3"><label class="form-label">CLASS</label><select name="class" class="form-select" style="width:300px;"><option value="CST" <%= person.class === 'CST' ? 'selected' : '' %>>고객</option><option value="CEO" <%= person.class === 'CEO' ? 'selected' : '' %>>경영자</option><option value="MNG" <%= person.class === 'MNG' ? 'selected' : '' %>>관리자</option></select></div>
    <% } %>
    <button class="btn btn-outline-primary btn-sm" type="submit"><%= signup ? '회원가입' : (mode === 'create' ? '입력' : '수정') %></button>
    <% if(!signup) { %><a href="/person/view"><button class="btn btn-outline-primary btn-sm" type="button">고객 목록 돌아가기</button></a><% } %>
  </form>
</div>
