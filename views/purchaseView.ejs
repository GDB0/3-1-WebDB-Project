<table class="table table-bordered" style="text-align:center;">
  <tr><th>고객ID</th><th>고객명</th><th>상품ID</th><th>상품명</th><th>구매일</th><th>가격</th><th>포인트</th><th>구매량</th><th>총가격</th><th>결제여부</th><th>취소여부</th><th>환불여부</th><th colspan="2"></th></tr>
  <% if(purchases.length === 0) { %>
    <tr><td colspan="13">자료가 없으니 고객이 상품을 구매해야 합니다.</td></tr>
  <% } else { %>
    <% purchases.forEach(function(p){ %>
      <tr><td><%= p.loginid %></td><td><%= p.person_name %></td><td><%= p.prod_id %></td><td><%= p.product_name %></td><td><%= p.date %></td><td><%= p.price %></td><td><%= p.point %></td><td><%= p.qty %></td><td><%= p.total %></td><td><%= p.payYN %></td><td><%= p.cancel %></td><td><%= p.refund || 'N' %></td>
      <td><a href="/purchase/update/<%= p.purchase_id %>">수정</a></td><td><a href="/purchase/delete/<%= p.purchase_id %>" onclick="if(confirm('정말로 삭제하시겠습니까?')==false) return false">삭제</a></td></tr>
    <% }) %>
  <% } %>
</table>
