<h2>게시판 종류</h2>

<table class="table table-bordered border-primary table-hover" style="text-align: center;">
  <thead class="table-primary">
    <tr>
      <th>제목</th>
      <th>페이지당 글 수</th>
      <th>설명</th>
      <th>일반 사용자 쓰기</th>
      <th>댓글</th>
      <th colspan="2">메뉴</th>
    </tr>
  </thead>

  <tbody>
    <% if(!boardtypes || boardtypes.length === 0) { %>
      <tr>
        <td colspan="7">자료가 없으니 게시판 종류 추가 버튼으로 게시판 종류를 추가해 주십시오.</td>
      </tr>
    <% } else { %>
      <% boardtypes.forEach(function(bt){ %>
        <tr>
          <td><%- bt.title %></td>
          <td><%= bt.numPerPage %></td>
          <td><%- bt.description %></td>
          <td><%= bt.write_YN %></td>
          <td><%= bt.re_YN %></td>
          <td><a href="/board/type/update/<%= bt.type_id %>" style="text-decoration:none;">수정</a></td>
          <td>
            <a href="/board/type/delete/<%= bt.type_id %>"
               onclick="if(confirm('정말로 삭제하시겠습니까?')==false){return false}"
               style="text-decoration:none;">삭제</a>
          </td>
        </tr>
      <% }) %>
    <% } %>
  </tbody>
</table>

<a href="/board/type/create">
  <button class="btn btn-outline-secondary btn-sm" type="button">게시판 종류 추가</button>
</a>
