<div class="container">
  <h2 style="text-align:center; margin-bottom:20px;">tableManage.ejs</h2>

  <table class="table table-bordered border-primary table-hover" style="text-align:center; width:900px; margin:auto;">
    <thead class="table-primary">
      <tr>
        <th>테이블명</th>
        <th>테이블 설명</th>
      </tr>
    </thead>
    <tbody>
      <% if(!tables || tables.length === 0) { %>
        <tr>
          <td colspan="2">테이블이 없습니다.</td>
        </tr>
      <% } else { %>
        <% tables.forEach(function(table) { %>
          <tr>
            <td>
              <a href="/dbadmin/tableView/<%= table.TABLE_NAME %>"><%= table.TABLE_NAME %></a>
            </td>
            <td><%= table.TABLE_COMMENT || '' %></td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>
