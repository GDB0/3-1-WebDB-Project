<div class="container">
<h2>cart 테이블 수정</h2>
<form action="/purchase/cart/update_process" method="post">
  <input type="hidden" name="cart_id" value="<%= cart.cart_id %>">
  <div class="mb-3"><label class="form-label">고객</label>
    <select name="loginid">
      <% persons.forEach(function(p){ %><option value="<%= p.loginid %>" <%= cart.loginid===p.loginid?'selected':'' %>><%= p.name %></option><% }) %>
    </select>
  </div>
  <div class="mb-3"><label class="form-label">상품</label>
    <select name="prod_id">
      <% products.forEach(function(p){ %><option value="<%= p.prod_id %>" <%= Number(cart.prod_id)===Number(p.prod_id)?'selected':'' %>><%= p.name %></option><% }) %>
    </select>
  </div>
  <div class="mb-3"><label class="form-label">날짜</label><input class="form-control" type="text" name="date" value="<%= cart.date %>" readonly style="width:300px;background-color:rgb(204,203,203);"></div>
  <button class="btn btn-outline-primary btn-sm" type="submit">수정</button>
  <a href="/purchase/cart/view"><button class="btn btn-outline-primary btn-sm" type="button">카트 목록 돌아가기</button></a>
</form>
</div>
